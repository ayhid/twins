{
  "provider": "github",
  "github": {
    "repo": "ayhid/twins",
    "labels": {
      "In Progress": "status: in progress",
      "In Review": "status: in review",
      "Done": "status: done",
      "type": {
        "Bug": "bug",
        "Feature": "enhancement"
      }
    }
  },
  "language": "English",
  "states": {
    "start": "In Progress",
    "review": "In Review",
    "done": "Done",
    "abandon": "Backlog",
    "ladder": [
      "Backlog",
      "In Progress",
      "In Review",
      "Done"
    ]
  },
  "branch": {
    "pattern": "<type>/<ID>-<slug>",
    "base": "main",
    "mode": "worktree",
    "types": {
      "Bug": "fix",
      "Feature": "feat"
    }
  },
  "delivery": {
    "mode": "direct"
  },
  "commit": {
    "pattern": "type(scope): description (<ID>)",
    "position": "suffix",
    "noTicketEscape": "chore(no-ticket)"
  },
  "issueTypes": [
    "Bug",
    "Feature"
  ],
  "repos": [
    {
      "path": ".",
      "checks": [
        "cargo fmt --all --check",
        "cargo clippy --workspace --all-targets -- -D warnings",
        "cargo test --workspace"
      ]
    }
  ]
}
